# 複製成 .env 後用 `node --env-file=.env dist/main.js` 啟動。
# 整段留空就是「這個部署不用資料庫」——Server 一樣跑得起來，只是碰資料庫的 Tool 會回
# ASK_OPERATOR。

# PostgreSQL 連線字串。唯一必填的一項。
DATABASE_URL=postgres://user:password@localhost:5432/mydb

# 以下都可不填，預設值見 src/db/config.ts。
# 池子最多同時開幾條連線。
DATABASE_POOL_MAX=10
# 閒置多久之後把連線還回去（毫秒）。
DATABASE_IDLE_TIMEOUT_MS=30000
# 等一條可用連線最多等多久（毫秒）。
DATABASE_CONNECTION_TIMEOUT_MS=5000
# 單一 SQL 最多跑多久（毫秒），由 PostgreSQL 自己中止。
DATABASE_STATEMENT_TIMEOUT_MS=10000
