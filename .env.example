# 複製成 .env 後用 `node --env-file=.env dist/main.js` 啟動。
# 整段留空就是「這個部署不用資料庫」——Server 一樣跑得起來，只是碰資料庫的 Tool 會回
# ASK_OPERATOR。

# PostgreSQL 連線字串。唯一必填的一項。
DATABASE_URL=postgres://user:password@localhost:5432/mydb

# 以下都可不填，預設值見 src/db/config.ts。
# 池子最多同時開幾條連線。
DATABASE_POOL_MAX=10
# 閒置多久之後把連線還回去（毫秒）。
DATABASE_IDLE_TIMEOUT_MS=30000
# 等一條可用連線最多等多久（毫秒）。
DATABASE_CONNECTION_TIMEOUT_MS=5000
# 單一 SQL 最多跑多久（毫秒），由 PostgreSQL 自己中止。
DATABASE_STATEMENT_TIMEOUT_MS=10000

# 多回合流程（MRTR）那份 requestState 的 HMAC 金鑰，至少 32 bytes。
# 不填的話開機時隨機產生一把——走 stdio 時一個行程服務整個流程，這樣就夠。
# 改成 HTTP、或是多個行程可能接到同一段流程的不同回合時，必須填，而且大家要一樣。
REQUEST_STATE_SECRET=

# ── 驗證層 ───────────────────────────────────────────────────────────
# none（預設）：不驗身分。只有綁 loopback 的部署可以這樣。
# jwt：驗中央機關簽發的 token。
MCP_AUTH_MODE=none

# 以下只在 MCP_AUTH_MODE=jwt 時要填。
# 預期的 iss。
MCP_AUTH_JWT_ISSUER=https://auth.example.gov.tw
# 預期的 aud，也就是這台 Server 的資源識別碼。
# 少了它，發給別的系統的 token 也能打進這台。
MCP_AUTH_JWT_AUDIENCE=https://mcp.example.gov.tw
# 公鑰從哪來，兩者擇一。JWKS 端點可以讓簽發端輪替金鑰而不必重啟這台；
# 還沒有簽發服務的階段用 PEM。
MCP_AUTH_JWT_JWKS_URL=
MCP_AUTH_JWT_PUBLIC_KEY=
# 只認非對稱簽章。預設 ES256,RS256；HS* 會被拒絕，因為那需要這台持有簽得出 token 的密鑰。
MCP_AUTH_JWT_ALGORITHMS=ES256,RS256
