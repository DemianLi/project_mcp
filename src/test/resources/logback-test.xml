<!-- Tests provoke GhCli failures on purpose; at WARN level their argv is logged. This config
     silences that noise. It also prevents Spring Boot's file appender from being installed
     when the test classpath includes target/test-classes, making the Server's output invisible
     except to tests that explicitly redirect logging. TraceContractAcceptanceTest drops
     test-classes and redirects the log to assert on contents. -->
<configuration>
  <logger name="io.github.demianli.projectmcp.gh.GhCli" level="OFF"/>
  <root level="WARN"/>
</configuration>
